# OCR服务配置文件示例
# 复制此文件为 .env 并修改配置

# 服务配置
HOST=0.0.0.0
PORT=8765

# 本地OCR引擎配置
# 可选值: none, easyocr, tesseract
# 只使用 Ollama/GLM-OCR 时建议设为 none，避免启动时下载或初始化 EasyOCR 模型
OCR_ENGINE=none

# /ocr 接口按需加载的本地OCR引擎
# 需要文本位置 bbox 时调用 /ocr，会首次懒加载该引擎
OCR_LAZY_ENGINE=easyocr

# OCR语言列表（逗号分隔）
OCR_LANGUAGES=["ch_sim"]

# 是否使用GPU
OCR_USE_GPU=false

# Tesseract路径（仅在使用Tesseract时需要）
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# LMStudio配置
LMSTUDIO_API_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=glm-ocr
LMSTUDIO_TIMEOUT=60

# VLM接口模式：openai 用于 LM Studio/vLLM；ollama 用于 Ollama 原生 /api/generate
VLM_API_MODE=openai

# 模型OCR最大输出token数，避免Ollama异常重复输出导致请求卡住
VLM_MAX_TOKENS=512

# 日志级别
LOG_LEVEL=INFO
