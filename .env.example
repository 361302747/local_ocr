# OCR服务配置文件示例
# 复制此文件为 .env 并修改配置

# 服务配置
HOST=0.0.0.0
PORT=8765

# OCR引擎配置
# 可选值: paddleocr, easyocr, tesseract
OCR_ENGINE=paddleocr

# OCR语言列表（逗号分隔）
OCR_LANGUAGES=["ch_sim"]

# 是否使用GPU
OCR_USE_GPU=false

# Tesseract路径（仅在使用Tesseract时需要）
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# LMStudio配置
LMSTUDIO_API_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=glm-ocr
LMSTUDIO_TIMEOUT=60

# 日志级别
LOG_LEVEL=INFO
